*.msp.gz filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
src/sphingolipid_toolkit/data/*.csv.gz filter=lfs diff=lfs merge=lfs -text

# Rule fingerprints must survive clones on Windows and Linux.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Preserve the exact attributed upstream snapshot, including trailing newlines.
src/sphingolipid_toolkit/_vendor/** -whitespace
